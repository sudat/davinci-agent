{
  "schema_version": "channel-presentation-profile-v1",
  "channel_id": "default",
  "allowed_recipe_families": [
    "audio",
    "branding",
    "color",
    "motion",
    "subtitle",
    "title",
    "transitions"
  ],
  "density": {
    "per_kind": [
      {"kind": "emphasis_punch_in", "cap_per_minute": 2.0},
      {"kind": "broll_cutaway", "cap_per_minute": 4.0},
      {"kind": "lower_third", "cap_per_minute": 2.0},
      {"kind": "keyword_text", "cap_per_minute": 3.0},
      {"kind": "chapter_card", "cap_per_minute": 1.0},
      {"kind": "simple_dissolve", "cap_per_minute": 4.0},
      {"kind": "motion_transition", "cap_per_minute": 2.0},
      {"kind": "picture_in_picture", "cap_per_minute": 1.0},
      {"kind": "screen_highlight", "cap_per_minute": 2.0},
      {"kind": "sfx_accent", "cap_per_minute": 3.0}
    ],
    "global_per_minute": 12.0
  },
  "title_choices": {
    "opening": "title/opening",
    "chapter": "title/opening",
    "lower_third": "title/lower-third"
  },
  "subtitle_style": {
    "recipe_id": "subtitle/default",
    "max_line_length_chars": 32,
    "font_size_px": 24,
    "font": "Hiragino Sans W5",
    "size_screen_ratio": 0.055,
    "center": [0.5, 0.14],
    "shadow": {
      "enabled": true,
      "color": [0, 0, 0],
      "alpha": 204,
      "softness": 0.005,
      "offset_x": 0.025,
      "offset_y": -0.04
    }
  },
  "telop_style": {
    "recipe_id": "telop/default",
    "font": "Hiragino Sans W6",
    "opening": {
      "size_px_base": 97,
      "size_px_min": 64,
      "box": {"x": 96, "w": 1632, "center_v": true},
      "band": {"fill": [10, 10, 10], "alpha": 140, "pad_x": 23, "pad_y": 19},
      "outline": {"color": [16, 16, 16], "width_ratio": 0.04, "min_px": 2}
    },
    "persistent": {
      "size_px_base": 43,
      "size_px_min": 27,
      "box": {"x": 48, "y": 27, "w": 624},
      "band": {"fill": [255, 255, 255], "alpha": 230, "pad_x": 15, "pad_y": 12},
      "outline": {"color": [16, 16, 16], "width_ratio": 0.04, "min_px": 2},
      "text_color": [10, 10, 10]
    },
    "persistent_second": {
      "size_px_base": 36,
      "size_px_min": 20,
      "band": {"fill": [10, 10, 10], "alpha": 255, "pad_x": 15, "pad_y": 10},
      "text_color": [255, 255, 255],
      "indent_right_px": 24,
      "offset_below_px": 0
    },
    "chapter": {"size_px": 97, "background": "black-full"}
  },
  "transition_preferences": {
    "preferred_order": ["dissolve", "motion", "hard_cut"],
    "max_duration_frames": 30
  },
  "punch_in_range": {
    "min": 1.05,
    "max": 1.3
  },
  "audio_policy": {
    "dialogue_lufs": {
      "min": -23.0,
      "max": -14.0
    },
    "true_peak_db": {
      "min": -3.0,
      "max": -1.0
    },
    "bgm_duck_level_db": {
      "min": -20.0,
      "max": -6.0
    },
    "sfx": {
      "allowed": true,
      "max_per_minute": 3.0
    }
  },
  "color_policy": {
    "technical_normalize_required": true,
    "shot_match_required": true,
    "channel_look": "color/channel-look"
  },
  "intro_outro": {
    "mode": "optional",
    "max_duration_frames": 180
  },
  "brand_assets": {
    "fonts": ["NotoSansJP"],
    "logo": null,
    "safe_margin_pct": 5.0,
    "licenses": []
  }
}
